# Copy to .env and adjust. docker compose reads it automatically.

# Public URL people and agents use to reach Radicle (used for cookies and MCP snippets).
RADICLE_BASE_URL=http://localhost:8000
# Host port for the app container.
RADICLE_PORT=8000
# Time zone for relative dates in RQL (e.g. America/Mexico_City). Default UTC.
RADICLE_TIMEZONE=UTC
# Secure cookies: empty = automatic (on when RADICLE_BASE_URL is https). true/false to force.
# RADICLE_COOKIE_SECURE=true
# Session length in days (sliding).
RADICLE_SESSION_DAYS=14
# Login attempts per minute per IP.
RADICLE_LOGIN_RATE_LIMIT_PER_MINUTE=10
# Built SPA directory; the Docker image sets it to /app/static.
# RADICLE_STATIC_DIR=../frontend/dist

# Postgres credentials used by docker compose. Change the password in production.
POSTGRES_USER=radicle
POSTGRES_PASSWORD=radicle
POSTGRES_DB=radicle
# Only needed when running the backend outside Docker:
RADICLE_DATABASE_URL=postgresql+asyncpg://radicle:radicle@localhost:5432/radicle
