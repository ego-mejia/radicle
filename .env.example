# Copy to .env and adjust. docker compose reads it automatically.

# Names of this checkout's containers, volumes and image. The defaults (gumball-factory) suit
# the install you use every day; a development checkout should use its own names so it
# never touches that install's data:
# COMPOSE_PROJECT_NAME=gumball-factory-dev
# GUMBALL_FACTORY_IMAGE=gumball-factory-dev

# Public URL people and agents use to reach Gumball Factory (used for cookies and MCP snippets).
GUMBALL_FACTORY_BASE_URL=http://localhost:8000
# Host port for the app container.
GUMBALL_FACTORY_PORT=8000
# Time zone for relative dates in RQL (e.g. America/Mexico_City). Default UTC.
GUMBALL_FACTORY_TIMEZONE=UTC
# Working days for burndowns.
GUMBALL_FACTORY_WORKDAYS=mon,tue,wed,thu,fri
# Secure cookies: empty = automatic (on when GUMBALL_FACTORY_BASE_URL is https). true/false to force.
# GUMBALL_FACTORY_COOKIE_SECURE=true
# Session length in days (sliding).
GUMBALL_FACTORY_SESSION_DAYS=14
# Login attempts per minute per IP.
GUMBALL_FACTORY_LOGIN_RATE_LIMIT_PER_MINUTE=10
# Built SPA directory; the Docker image sets it to /app/static.
# GUMBALL_FACTORY_STATIC_DIR=../frontend/dist

# Required: encrypts secrets in the database (SSO, captcha keys) and signs links.
# Generate one with: openssl rand -hex 32. Changing it makes stored secrets unreadable.
GUMBALL_FACTORY_SECRET_KEY=
# Attachments: local (docker volume /data/attachments) or s3 (AWS, MinIO, R2...).
GUMBALL_FACTORY_STORAGE=local
GUMBALL_FACTORY_MAX_UPLOAD_MB=25
GUMBALL_FACTORY_AUDIT_RETENTION_DAYS=730
# Radi, the in-app assistant. Leave unset to configure it in Admin → Settings → Assistant.
# Setting the provider here overrides the app: anthropic, openai (any compatible server) or none.
# GUMBALL_FACTORY_ASSISTANT_PROVIDER=anthropic
# GUMBALL_FACTORY_ASSISTANT_API_KEY=
# GUMBALL_FACTORY_ASSISTANT_MODEL=claude-haiku-5-5
# GUMBALL_FACTORY_ASSISTANT_BASE_URL=http://ollama:11434/v1
# Default size for uploaded images: original, large (2048 px), medium (1280 px), small (800 px).
GUMBALL_FACTORY_IMAGE_DEFAULT_RESIZE=large
# Only with GUMBALL_FACTORY_STORAGE=s3. Leave the endpoint empty for AWS.
# GUMBALL_FACTORY_S3_BUCKET=gumball-factory
# GUMBALL_FACTORY_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# GUMBALL_FACTORY_S3_REGION=us-east-1
# GUMBALL_FACTORY_S3_ACCESS_KEY=
# GUMBALL_FACTORY_S3_SECRET_KEY=

# Email notifications. Without a host, notifications are in-app only.
# GUMBALL_FACTORY_SMTP_HOST=smtp.example.com
# GUMBALL_FACTORY_SMTP_PORT=587          # 465 uses implicit TLS
# GUMBALL_FACTORY_SMTP_USER=
# GUMBALL_FACTORY_SMTP_PASSWORD=
# GUMBALL_FACTORY_SMTP_FROM=Gumball Factory <gumball-factory@example.com>
# GUMBALL_FACTORY_SMTP_TLS=true          # STARTTLS on 587

# Postgres credentials used by docker compose. Change the password in production.
POSTGRES_USER=gumball-factory
POSTGRES_PASSWORD=gumball-factory
POSTGRES_DB=gumball-factory
# Only needed when running the backend outside Docker:
GUMBALL_FACTORY_DATABASE_URL=postgresql+asyncpg://gumball_factory:gumball_factory@localhost:5432/gumball_factory
